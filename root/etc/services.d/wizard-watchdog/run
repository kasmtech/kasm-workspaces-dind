#!/usr/bin/with-contenv bash

if [[ -L /opt/kasm/current || -e /opt/kasm/current || -f /opt/kasm/.wizard_install_complete ]]; then
  exec sleep infinity
fi

# The wizard writes this only after install.sh exits successfully, a failed
# install keeps the wizard available
until [[ -f /opt/kasm/.wizard_install_complete ]]; do
  sleep 5
done

setup="${KASM_SETUP,,}"
setup="${setup//[[:space:]]/}"
if [[ "${setup}" != "true" ]]; then
  echo "First-run install complete, stopping install wizard"
  # Take the service down so s6 does not restart it, the wizard gate covers container restarts
  s6-svc -d /var/run/s6/services/wizard 2>/dev/null || pkill --signal SIGTERM -f '/usr/bin/node index.js'
fi

exec sleep infinity
