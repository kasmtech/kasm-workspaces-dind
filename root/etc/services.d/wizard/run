#!/usr/bin/with-contenv bash

# Wait for docker to be up
while [[ ! -S /var/run/docker.sock ]]; do
  sleep 1
done

# Stopped from the wizard ("Stop Install Wizard"), before or after install
if [[ -f /opt/NO_WIZARD ]]; then
  echo "/opt/NO_WIZARD exists, install wizard disabled"
  exec sleep infinity
fi

# First-run setup is always allowed (including retrying a wizard install that failed
# before /opt/kasm/current was created), after install the wizard needs KASM_SETUP=true
if [[ -L /opt/kasm/current ]] && [[ "${KASM_SETUP}" != "true" ]]; then
  echo "Kasm is installed and KASM_SETUP is not 'true', install wizard disabled"
  exec sleep infinity
fi

cd /wizard || exit 1
exec /usr/bin/node index.js
